package-as: SkillsAlreadyKnown

enable-nolib-creation: no

ignore:
  - .git
  - .github
  - .gitignore
  - .gitattributes
  - .pkgmeta
  - AGENTS.md
  - "**/AGENTS.md"
  - CONTRIBUTING.md
  - patchnote
  - scripts
  - release
  - releases
  - dist
  - build
  - .codex
  - .agents
  - .aws
  - "*.zip"
  - "*.7z"
  - "*.tar"
  - "*.tar.gz"
  - "WTF"
  - "Cache"
  - "Logs"
  - "Errors"
  - ".vscode"
  - ".idea"
  - ".packager"
  - "__pycache__"
  - ".env"
  - ".env.*"
  - "*.pyc"
  - "*.pyo"
  - "*.pkg"

plain-copy:
  - libs

manual-changelog:
  filename: release/latest/patchnote.md
  markup-type: markdown
